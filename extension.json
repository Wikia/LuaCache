{
	"name": "LuaCache",
	"version": "1.0.0",
	"author": [
		"Robert Nix"
	],
	"url": "https://gitlab.com/HydraWiki/extensions/LuaCache",
	"descriptionmsg": "luacache-desc",
	"license-name": "MIT",
	"type": "parserhook",
	"requires": {
		"MediaWiki": ">= 1.29.0"
	},
	"MessagesDirs": {
		"LuaCache": [
			"i18n"
		]
	},
	"AutoloadClasses": {
		"LuaCache\\LuaCacheHooks": "src/LuaCacheHooks.php",
		"LuaCache\\LuaCacheLibrary": "src/LuaCacheLibrary.php"
	},
	"HookHandlers": {
		"main": {
			"class": "LuaCache\\LuaCacheHooks"
		}
	},
	"Hooks": {
		"ScribuntoExternalLibraries": "main"
	},
	"ServiceWiringFiles": ["ServiceWiring.php"],
	"manifest_version": 2
}
